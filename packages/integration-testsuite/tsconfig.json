{
  "extends": "../../tsconfig.base",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/esm",
    "lib": ["es2023"],
    // @apollo/client 4's link typings reference DOM fetch types (eg
    // RequestCredentials) that are not in the Node lib.
    "skipLibCheck": true,
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../cache-control-types"},
    { "path": "../server" },
  ],
}
